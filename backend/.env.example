# Copy this file to .env and adjust values. The server reads these via
# process.env if present, but will run with sensible defaults if you skip this.

PORT=4000

# Comma-separated list of origins allowed to call this API from a browser.
# Use * only for local development.
CORS_ORIGIN=*

# Session token lifetime, in hours.
SESSION_TTL_HOURS=168

# Seed admin account created automatically on first run.
SEED_ADMIN_EMPLOYEE_ID=DF-0001
SEED_ADMIN_EMAIL=admin@dayflow.io
SEED_ADMIN_PASSWORD=Admin@123
